### ==========================================
### GET ALL ORGANIZATIONS
### ==========================================

GET http://localhost:5000/api/organization/getAll
Authorization: Bearer {{token}}

### ==========================================
### GET ORGANIZATION BY ID
### ==========================================

GET http://localhost:5000/api/organization/get/ORGANIZATION_ID
Authorization: Bearer {{token}}

### ==========================================
### UPDATE ORGANIZATION
### ==========================================

PUT http://localhost:5000/api/organization/update/ORGANIZATION_ID
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "name": "Commercial Bank of Ethiopia PLC",
  "emailDomain": "cbe.org.et"
}

### ==========================================
### DEACTIVATE ORGANIZATION
### ==========================================

PATCH http://localhost:5000/api/organization/deactivate/ORGANIZATION_ID
Authorization: Bearer {{token}}

### ==========================================
### REACTIVATE ORGANIZATION
### ==========================================

PATCH http://localhost:5000/api/organization/reactivate/ORGANIZATION_ID
Authorization: Bearer {{token}}