{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",

    

    "strict": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,

    "types": ["node"],

    "outDir": "./dist",

    "skipLibCheck": true
  },
  "include": ["src", "generated", "prisma/seed.ts"]
}
